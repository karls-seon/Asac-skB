# API 키 등 비밀값 - 절대 커밋 금지
.env

# 원본 캐시(500MB+, README 참고) - 재수집으로 언제든 다시 만들 수 있다
data/raw_cache/

# Claude Code 로컬 설정 - 이 컴퓨터에서만 의미 있음
.claude/

# 에이전트 실행 기록 - 컴퓨터마다 다른 실행 이력이라 공유하면 충돌만 난다
data/review/agent_run_log.jsonl

# 구조변경 진단 기준선 - 이 컴퓨터의 raw_cache 상태에서 파생된 값이고,
# 모요 요금제가 매일 바뀌어서 커밋하면 diff만 시끄럽다.
# 새 컴퓨터에서는 `python src/agents/schema_drift.py --baseline`으로 만든다.
data/review/parse_coverage.json

__pycache__/
*.pyc
